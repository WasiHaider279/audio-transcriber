{
  "name": "transcription-pipeline",
  "version": "1.0.0",
  "description": "Audio transcription pipeline using Whisper — accepts audio files, transcribes speech to text, returns timestamped segments.",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "cli": "node src/cli.js"
  },
  "keywords": [
    "transcription",
    "whisper",
    "speech-to-text",
    "audio"
  ],
  "license": "MIT",
  "dependencies": {
    "@huggingface/transformers": "^3.4.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "ffmpeg-static": "^5.2.0",
    "fluent-ffmpeg": "^2.1.3",
    "multer": "^1.4.5-lts.1",
    "wavefile": "^11.0.0",
    "winston": "^3.17.0"
  },
  "allowScripts": {
    "ffmpeg-static@5.3.0": true,
    "onnxruntime-node@1.21.0": true,
    "protobufjs@7.6.5": true,
    "sharp@0.34.5": true
  }
}
