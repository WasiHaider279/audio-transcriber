# ---- Server ----
PORT=3000

# ---- Engine ----
# Options: "mock" | "whisper"
# Use "mock" for development/testing (no model download needed)
# Use "whisper" for real transcription
ENGINE=mock

# ---- Whisper Config (only used when ENGINE=whisper) ----
# Model ID from Hugging Face Hub (ONNX format)
WHISPER_MODEL=onnx-community/whisper-small
# Options: "word" | "segment"
TIMESTAMP_MODE=segment

# ---- Upload ----
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=50
